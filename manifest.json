
{
  "manifest_version": 3,
  "name": "Hydrogen",
  "version": "0.0.4",
  "description": "Browser Client",

  "icons": {
    "16": "icon/HYD.png",
    "32": "icon/HYD.png",
    "48": "icon/HYD.png",
    "128": "icon/HYD.png"
  },

  "action": {
    "default_icon": {
      "16": "icon/HYD.png",
      "32": "icon/HYD.png",
      "48": "icon/HYD.png",
      "128": "icon/HYD.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icon/HYD.png",
        "icon/H1K.png",
        "icon/KA.png",
        "icon/smudgy.png",
        "icon/ktiersIcon.png",
        "Backgrounds/Default.png",
        "Backgrounds/main.png",
        "Backgrounds/halloween.webp",
        "Backgrounds/nvo.webp",
        "Backgrounds/Tkh.webp",
        "Backgrounds/Gtmts.webp",
        "Backgrounds/Os.webp",
        "Backgrounds/efk.webp",
        "Backgrounds/Juice.webp",
        "json/CardInfo.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://kirka.io/*",
        "https://snipers.io/*",
        "https://ask101math.com/*",
        "https://fpsiogame.com/*",
        "https://cloudconverts.com/*"
      ],
      "js": [
        "plugins/CustomPlayerColor.js",
        "plugins/RoleDisplay.js",
        "plugins/FriendsbannedColor.js",
        "plugins/TwichNews.js",
        "plugins/SbAndBt.js",
        "plugins/SkinTextureDownloader.js",
        "plugins/ItemPriceInfo.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kirka.io/*",
        "https://snipers.io/*",
        "https://ask101math.com/*",
        "https://fpsiogame.com/*",
        "https://cloudconverts.com/*"
      ],
      "js": [
        "lib/dom.js",
        "lib/storage.js",
        "lib/injector.js",
        "lib/drag.js",
        "ui/topbar.js",
        "ui/search.js",
        "ui/sidebar.js",
        "ui/styleTab.js",
        "ui/clientTab.js",
        "ui/hotkeysTab.js",
        "ui/changelogTab.js",
        "ui/menu.js",
        "content.js"
      ],
      "css": ["styles/menu.css"],
      "run_at": "document_idle"
    }
  ]
}
