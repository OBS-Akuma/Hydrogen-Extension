
{
  "manifest_version": 3,
  "name": "Hydrogen",
  "version": "0.0.1",
  "description": "Browser Client",

  "icons": {
    "16": "icon/HYD.png",
    "32": "icon/HYD.png",
    "48": "icon/HYD.png",
    "128": "icon/HYD.png"
  },

  "action": {
    "default_icon": {
      "16": "icon/HYD.png",
      "32": "icon/HYD.png",
      "48": "icon/HYD.png",
      "128": "icon/HYD.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icon/HYD.png",
        "icon/H1K.png",
        "icon/KA.png",
        "Backgrounds/Default.png",
        "Backgrounds/main.png",
        "Backgrounds/halloween.webp",
        "json/CardInfo.json"
      ],
      "matches": [
        "https://snipers.io/*",
        "https://ask101math.com/*",
        "https://fpsiogame.com/*",
        "https://cloudconverts.com/*"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://kirka.io/*",
        "https://snipers.io/*",
        "https://ask101math.com/*",
        "https://fpsiogame.com/*",
        "https://cloudconverts.com/*"
      ],
      "js": [
        "plugins/CustomPlayerColor.js",
        "plugins/RoleDisplay.js",
        "plugins/SkinTextureDownloader.js",
        "plugins/ItemPriceInfo.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kirka.io/*",
        "https://snipers.io/*",
        "https://ask101math.com/*",
        "https://fpsiogame.com/*",
        "https://cloudconverts.com/*"
      ],
      "js": [
        "lib/dom.js",
        "lib/storage.js",
        "lib/injector.js",
        "lib/drag.js",
        "ui/topbar.js",
        "ui/search.js",
        "ui/sidebar.js",
        "ui/styleTab.js",
        "ui/clientTab.js",
        "ui/menu.js",
        "content.js"
      ],
      "css": ["styles/menu.css"],
      "run_at": "document_idle"
    }
  ]
}
